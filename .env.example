# ==============================================================================
# SARI-SARI STORE IMS - CENTRALIZED CONFIGURATION (.env)
# ==============================================================================
# Single source of truth for Docker Compose, Laravel Backend, and Next.js Frontend.

# Application Identity & Lifecycle
APP_NAME="Sari-Sari Store"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
APP_ONBOARDED=false

# System Networking & Ports
FRONTEND_PORT=3001
BACKEND_PORT=8000

# MySQL Database (Pre-configured defaults for local Docker container)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sari_inventory
DB_USERNAME=lwui
DB_PASSWORD=Water123!
DB_ROOT_PASSWORD=Water123!

# Google Gemini AI (OCR receipt reader & smart catalog tools)
# Generate a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=/api
INTERNAL_BACKEND_URL=http://backend:8000

