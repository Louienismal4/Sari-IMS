# ==============================================================================
# SARI-SARI STORE IMS - RUNTIME ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Infrastructure configuration for Docker Compose, Laravel Backend, and Next.js Frontend.
# Application settings (store profile, currency) and integration secrets (AI keys)
# are configured post-launch via the /setup web onboarding wizard and stored in PostgreSQL.

# Application Identity & Lifecycle
APP_NAME="Sari-Sari Store"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

# System Networking & Ports
FRONTEND_PORT=3001
BACKEND_PORT=8000

# PostgreSQL Database (Container: postgres)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sari_inventory
DB_USERNAME=sari_user
DB_PASSWORD=ChangeThisToAStrongPassword!

# Redis Cache, Session & Queue (Container: redis)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=/api
INTERNAL_BACKEND_URL=http://backend:8000

