# ==============================================================================
# SARI PRODUCTION ENVIRONMENT TEMPLATE (.env)
# Place this .env file on your production server inside the deploy folder
# ==============================================================================

# GitHub Container Registry Info
DOCKER_IMAGE_OWNER=louienismal4
TAG=latest

# Domain & Web Server Port
PORT=80
DOMAIN=sari.louienismal.com

# PostgreSQL Database Settings
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sari_inventory
DB_USERNAME=sari_prod_user
DB_PASSWORD=ChangeThisToAStrongPassword!

# Redis Settings
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Laravel Settings
APP_NAME="Sari-Sari Store"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_KEY_HERE
APP_URL=https://sari.louienismal.com
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
